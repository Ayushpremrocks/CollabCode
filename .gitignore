# === Project-specific exclusions ===
# Sensitive config (contains DB credentials, secrets)
**/application.yml
**/application.yaml

# Documentation (internal only)
docs/

# === Java / Spring Boot (backend) ===
backend/target/
*.class
*.jar
*.war
*.ear
*.log
hs_err_pid*

# === Node / React (frontend) ===
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# === IDE & Editor files ===
.idea/
.vscode/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# === OS files ===
.DS_Store
Thumbs.db

# === Environment files ===
.env
.env.*
!.env.example

# === Misc ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
