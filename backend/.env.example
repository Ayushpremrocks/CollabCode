# Backend environment variables — copy this to .env and fill in real values.
# .env is git-ignored. NEVER commit real credentials.
# Spring Boot does NOT auto-load .env files.
# Set these as environment variables in your shell, IDE, or deployment platform.

# Neon PostgreSQL (from Neon Dashboard → Connection Details → Connection string)
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Clerk JWKS URI (from Clerk Dashboard → API Keys → Show JWT public key → JWKS URL)
# Format: https://<frontend-api>/.well-known/jwks.json
CLERK_JWKS_URI=

# JWT secret — any long random string (32+ characters)
JWT_SECRET=

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# SQL init mode — use 'always' to run schema.sql on startup, 'never' to skip
SPRING_SQL_INIT_MODE=always
