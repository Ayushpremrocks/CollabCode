FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
# Cache dependencies in their own layer so code-only changes rebuild faster.
RUN mvn -q dependency:go-offline || true
COPY src ./src
RUN mvn -q clean package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/target/collab-code-editor-1.0.0.jar app.jar
EXPOSE 8080
# Render's free instance has 512 MB: size the heap from the container limit
# instead of the JVM default (25% of RAM) so large rooms don't run out of memory.
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-XX:+ExitOnOutOfMemoryError", "-jar", "app.jar"]
